load("//ada:defs.bzl", "ada_library", "ada_test")

# Assertion helpers shared by the tests in this package.
ada_library(
    name = "test_support",
    testonly = True,
    srcs = [
        "test_support.adb",
        "test_support.ads",
    ],
    visibility = ["//visibility:private"],
    deps = ["//ada/runfiles"],
)

# End-to-end lookup through whatever Bazel's test runner provides.
ada_test(
    name = "test_runfiles",
    srcs = ["test_runfiles.adb"],
    data = ["sample.txt"],
    deps = [
        ":test_support",
        "//ada/runfiles",
    ],
)

# The mode-specific tests below set or clear RUNFILES_MANIFEST_FILE,
# RUNFILES_DIR and TEST_SRCDIR themselves before calling Runfiles.Create,
# since the fixture paths are only known at run time (TEST_TMPDIR).

