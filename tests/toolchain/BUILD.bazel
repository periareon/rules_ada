ada_args(
    name = "bad_two_requires",
    actions = LINK_ACTIONS,
    args = ["x"],
    requires_none = "objects",
    requires_not_none = "objects",
    tags = ["manual"],
)

ada_args(
    name = "bad_compile_variable",
    actions = [ACTIONS.compile],
    args = ["{output}"],
    tags = ["manual"],
)

ada_feature(
    name = "bad_feature_name",
    feature_name = "-static_libgcc",
    tags = ["manual"],
)

ada_feature(
    name = "fake_feature_dup",
    feature_name = "fake_feature",
    tags = ["manual"],
)

ada_toolchain(
    name = "bad_enabled_unknown",
    binder = "fake/bin/gnatbind",
    compiler = "fake/bin/gcc",
    enabled_features = [":fake_feature"],
    tags = ["manual"],
    target_triple = "x86_64-pc-linux-gnu",
)

ada_toolchain(
    name = "bad_duplicate_feature",
    binder = "fake/bin/gnatbind",
    compiler = "fake/bin/gcc",
    known_features = [
        ":fake_feature",
        ":fake_feature_dup",
    ],
    tags = ["manual"],
    target_triple = "x86_64-pc-linux-gnu",
)

ada_toolchain(
    name = "bad_pattern",
    artifact_name_patterns = {"executable": "fixed"},
    binder = "fake/bin/gnatbind",
    compiler = "fake/bin/gcc",
    tags = ["manual"],
    target_triple = "x86_64-pc-linux-gnu",
)

ada_toolchain(
    name = "bad_pattern_category",
    artifact_name_patterns = {"dll": "%{name}.dll"},
    binder = "fake/bin/gnatbind",
    compiler = "fake/bin/gcc",
    tags = ["manual"],
    target_triple = "x86_64-pc-linux-gnu",
)

toolchain_test_suite(name = "toolchain_test_suite")

